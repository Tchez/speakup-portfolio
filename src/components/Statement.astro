---
import { rich } from '../data/site';

// One idea per slide: red label (section name) → large statement → one supporting paragraph.
interface Props {
  id: string;
  tone: 'white' | 'blue';
  copy: { label: string; heading: string; body: string };
}
const { id, tone, copy } = Astro.props;
---
<section class={`section statement ${tone === 'blue' ? 'section-blue on-dark' : 'section-white'}`} id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <p class="label statement-label" data-reveal>{copy.label}</p>
    <h2 class="slide-title statement-title" id={`${id}-title`} data-reveal>{copy.heading}</h2>
    <p class="statement-text" set:html={rich(copy.body)} data-reveal />
  </div>
</section>

<style>
  .statement-label { font-size: clamp(22px, .8vw + 16px, 34px); margin-bottom: 20px; }
  /* On blue, red text would be unreadable (≈1.3:1): the label becomes a red tag with white text (5.5:1). */
  .section-blue .statement-label { display: inline-block; background: var(--red-deep); color: var(--white); padding: .2em .5em .08em; border-radius: 6px; }
  .statement-title { font-size: clamp(32px, 3.4vw + 14px, 96px); line-height: 1.06; text-wrap: balance; }
  .statement-text { margin-top: clamp(28px, 2vw + 12px, 48px); max-width: 70ch; font-size: clamp(19px, .9vw + 12px, 32px); line-height: 1.5; text-wrap: pretty; }
  .section-white .statement-text { color: var(--muted); }
  /* On the blue statement slide, key phrases are plain bold (several per paragraph), no red underline. */
  .section-blue .statement-text :global(.kw) { text-decoration: none; font-weight: 800; }
</style>
