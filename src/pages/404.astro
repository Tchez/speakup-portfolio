---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base locale="pt" title="Página não encontrada / Page not found — SpeakUp Community" description="Esta página não existe. Visite o SpeakUp Community em português ou em inglês. This page doesn’t exist. Visit SpeakUp Community in Portuguese or English." noindex canonicalPath="/404.html" alternates={{ pt: '/404.html', en: '/404.html' }}>
  <main id="main" class="not-found">
    <span class="blob" style="--size: 240px; --color: var(--blue); top: -100px; left: -100px;"></span>
    <span class="blob" style="--size: 200px; --color: var(--red); bottom: -80px; right: -80px; --duration: 32s;"></span>
    <div class="container inner">
      <img src={site.logo} width="520" height="520" alt="Logo do SpeakUp Community" />
      <p class="label code">404</p>
      <h1>Página não encontrada.<br /><span lang="en">Page not found.</span></h1>
      <div class="message">
        <p>Este endereço não leva a nenhuma página. Volte para o início para conhecer o SpeakUp.</p>
        <p lang="en">This address doesn’t lead to a page. Head back home to meet SpeakUp.</p>
      </div>
      <nav aria-label="Escolha um idioma / Choose a language">
        <a class="button" href="/">Início em português</a>
        <a class="text-link" href="/en/" lang="en">Home in English</a>
      </nav>
    </div>
  </main>
  <style>
    .not-found { position: relative; overflow: hidden; isolation: isolate; min-height: 100vh; display: grid; align-items: center; padding-block: 48px; }
    .inner { display: grid; justify-items: center; gap: 20px; text-align: center; }
    img { width: 120px; }
    .code { font-size: 32px; }
    .text-link { font-weight: 700; padding: 14px 8px; }
    h1 { font-size: clamp(30px, 6vw, 56px); }
    .message { display: grid; gap: 8px; max-width: 52ch; }
    nav { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px 20px; }
  </style>
</Base>
